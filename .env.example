# Media Manager Environment Variables
# Copy to .env and modify as needed. .env is gitignored — secrets live here.

# ---------- TMDb (used by the fix-names command) ----------
# TMDb v4 API Read Access Token (themoviedb.org → Settings → API).
# Never commit the real value.
TMDB_API_TOKEN=
TMDB_LANGUAGE=en-US
TMDB_TIMEOUT_SECONDS=20
TMDB_MAX_RETRIES=4

# ---------- Optional overrides ----------
# Override config file location
# MEDIA_MANAGER_CONFIG=/path/to/media-manager.conf

# Override encoding presets
# VT_PRESET=quality
# X265_PRESET=slow

# Override scan interval (seconds)
# SCAN_INTERVAL=300
